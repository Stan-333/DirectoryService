{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "DirectoryServiceDb": "Host=host;Port=port;Database=database;Username=username;Password=password",
    "Seq": "http://localhost:5341"
  },
  "DepartmentCleanup": {
    "Enabled": true,
    "RunAtUtc": "02:00:00",
    "RetentionMonths": 1
  },
  "Caching": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
