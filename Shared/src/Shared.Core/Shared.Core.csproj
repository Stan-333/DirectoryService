<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <!-- Подключается через ProjectReference; в NuGet публикуется только Shared.Kernel. -->
      <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Scrutor" />
      <!-- Kernel берётся из фида, как у всех потребителей: иначе в приложении окажутся две копии Shared.Kernel. -->
      <PackageReference Include="Stan333.SharedKernel" />
    </ItemGroup>

</Project>
