<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов для всего монорепозитория. Токенов здесь нет и быть не должно.
  Учётные данные для "github" (PAT с read:packages) задаются вне репозитория:
  - локально: в пользовательском NuGet.Config, команда "dotnet nuget add source" из Shared/src/Shared.Kernel/README.md;
  - в CI и Docker: переменная окружения NuGetPackageSourceCredentials_github="Username=<login>;Password=<token>".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/Stan-333/index.json" />
  </packageSources>

  <!-- Собственные пакеты Stan333.* берутся только из GitHub Packages, остальные — только из nuget.org.
       Так пакет с тем же именем, выложенный в nuget.org, не подменит наш (dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Stan333.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
